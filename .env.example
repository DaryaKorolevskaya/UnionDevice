# Скопируйте в .env и укажите ключ. Файл .env в .gitignore.

# Gemini — бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Альтернатива — Anthropic Claude (платный)
ANTHROPIC_API_KEY=

# auto (по наличию ключа: gemini → anthropic → mock) | gemini | anthropic | mock
UNION_PROVIDER=auto
# Модель; по умолчанию gemini-flash-latest / claude-opus-5-5
UNION_MODEL=
# Только для Claude: low | medium | high
UNION_EFFORT=medium
# Сколько попыток генерации с исправлением замечаний
UNION_MAX_ATTEMPTS=3
