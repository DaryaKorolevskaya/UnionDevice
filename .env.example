# Скопируйте в .env и укажите ключ. Файл .env в .gitignore.

# Бесплатный ключ OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Модели через запятую в порядке приоритета; если модель недоступна — берётся следующая.
# Пусто = список по умолчанию (NVIDIA Nemotron → Gemma 4 → openrouter/free).
# Бесплатные модели: python -m union_device.cli --models
UNION_MODELS=

# Свой OpenAI-совместимый API, например локальная Ollama: http://localhost:11434/v1
UNION_BASE_URL=

# Сколько попыток генерации с исправлением замечаний
UNION_MAX_ATTEMPTS=3

# 1 — разрешить платные модели OpenRouter (по умолчанию только :free)
UNION_ALLOW_PAID=
