# Скопируйте в .env и укажите ключ. Файл .env в .gitignore.

# OpenRouter — открытые модели, есть бесплатные: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Альтернативы
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# auto (по наличию ключа: openrouter → gemini → anthropic → mock) | openrouter | ollama | gemini | anthropic | mock
UNION_PROVIDER=auto
# Модель; по умолчанию google/gemma-4-31b-it:free (OpenRouter), qwen2.5:7b-instruct (Ollama)
UNION_MODEL=
# Свой адрес OpenAI-совместимого API (необязательно)
UNION_BASE_URL=
# Только для Claude: low | medium | high
UNION_EFFORT=medium
# Сколько попыток генерации с исправлением замечаний
UNION_MAX_ATTEMPTS=3
